# Build stage
FROM golang:1.27.3-alpine3.24 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/reports cmd/reports
COPY internal internal
COPY pkg pkg
COPY utils utils
RUN CGO_ENABLED=0 go build -o reports ./cmd/reports

# Run stage
FROM alpine:3.24
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=builder /app/reports .
EXPOSE 8081
CMD ["/app/reports"]
